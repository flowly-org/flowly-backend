# Where people open Flowly (no trailing slash). Put a reverse proxy with HTTPS in front for anything public.
PUBLIC_URL=http://localhost:8080
# Host names the API answers to: your domain, plus "api" for the web container's proxy.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Long random strings: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
WEB_PORT=8080
# Pin a release (e.g. 1.0.0) instead of following the latest build.
FLOWLY_VERSION=latest
# Optional
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
TELEGRAM_BOT_TOKEN=
PLANS_ENABLED=0
